{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["build/**", "**/__tests__/**"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "e",
        "caughtErrorsIgnorePattern": "e"
      }
    ]
  }
}
